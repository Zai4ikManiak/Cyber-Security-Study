# Server Environment:

OS := $(shell . /etc/os-release && printf '%s' "$$ID")

ifneq ($(filter ubuntu debian,$(OS)),)
PKG_MNGR := apt
else ifneq ($(filter centos fedora,$(OS)),)
	PKG_MNGR := yum
else
	PKG_NMGR := unknown
endif

HOME := "/tmp"

# Zabbix Server Environment:

ZABBIX_SERVER_VER := "zabbix-7.4.14"
ZABBIX_SERVER_VER_URL := "7.4"

ZABBIX_SERVER_USER := "zabbix_server"
ZABBIX_SERVER_USER_PASS := "$(shell tr -dc 'A-Za-z0-9!@#$%^&*-' < /dev/urandom | head -c 20)"
